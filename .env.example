# Copy this file to .env: `cp .env.example .env`
#
# docker-compose.yml reads .env automatically. Running the DAG or
# scripts/fetch_and_predict.py outside Docker needs these loaded into your
# shell first:
#
#   set -a; source .env; set +a

# Linux only: the uid containers run as, so files they write on bind mounts
# (./data, ./logs, ./mlflow-data) are owned by you, not root. `id -u` prints
# yours. Harmless to leave as-is on macOS/Windows -- docker-compose.yml falls
# back to 50000 (the image's built-in airflow user) when this is unset.
AIRFLOW_UID=50000

# This project's own MLflow server (the `mlflow` service in
# docker-compose.yml). Only needed outside Docker -- docker-compose sets it
# for the airflow container itself.
MLFLOW_TRACKING_URI=http://127.0.0.1:15030
